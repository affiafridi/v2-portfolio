datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  type        String?
  year        Int
  role        String?
  client      String?
  duration    String?
  description String
  challenge   String?
  tags        String[]
  image       String
  url         String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  features    Json     @default("[]")
  gallery     String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  num          String
  title        String
  tag          String
  description  String
  points       String[]
  deliverables String[]
  image        String?
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  num       String
  category  String
  title     String
  excerpt   String
  content   String?  @db.Text
  date      String
  readTime  String
  image     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StackCategory {
  id        String      @id @default(cuid())
  num       String
  label     String
  desc      String
  sortOrder Int         @default(0)
  items     StackItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model StackItem {
  id         String        @id @default(cuid())
  name       String
  slug       String
  color      String
  sortOrder  Int           @default(0)
  categoryId String
  category   StackCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model SiteSettings {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

model ProjectType {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

model PostCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id           String    @id @default(cuid())
  ip           String    @unique
  attempts     Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @unique
  filename  String
  type      String   @default("image")
  alt       String   @default("")
  title     String   @default("")
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  interests String[]
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
}
